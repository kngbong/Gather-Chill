<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Dalamud.NET.Sdk/15.0.0">

  <PropertyGroup>
    <Version>1.0.0.10</Version>
    <Description>Gathering automation, to the max!.</Description>
    <PackageProjectUrl>https://github.com/kngbong/Gather-Chill</PackageProjectUrl>
    <PackageLicenseExpression>AGPL-3.0-or-later</PackageLicenseExpression>
    <IsPackable>true</IsPackable>
    <AssemblyName>GatherChillFork</AssemblyName>
    <PackageId>GatherChillFork</PackageId>
    <Authors>Ice, bongo</Authors>
    <RootNamespace>GatherChill</RootNamespace>
    <TargetFramework>net10.0-windows8.0</TargetFramework>
	<NoWarn>CS8618; CS8625; CS8629; </NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="GatheringRoutes\Heavensword\**" />
    <Compile Remove="Ui\DebugTabs\**" />
    <EmbeddedResource Remove="GatheringRoutes\Heavensword\**" />
    <EmbeddedResource Remove="Ui\DebugTabs\**" />
  </ItemGroup>

	<ItemGroup>
		<EmbeddedResource Include="GatheringRoutes\Routes\**\*.json" />
		<EmbeddedResource Include="Resources\*.png" />
	</ItemGroup>

	<ItemGroup>
	  <Content Include="GatherChillFork.json" />
	</ItemGroup>

  <ItemGroup>
      <PackageReference Include="ECommons" Version="3.2.1.26" />
      <PackageReference Include="Pictomancy" Version="1.0.10" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Update="DalamudPackager" Version="15.0.0" />
    <PackageReference Update="DotNet.ReproducibleBuilds" Version="2.0.5" />
  </ItemGroup>
  
  
</Project>
